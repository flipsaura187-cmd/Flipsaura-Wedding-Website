JWT_EXPIRES_IN=7d

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# Frontend URLs
CLIENT_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Admin Seed Credentials
ADMIN_EMAIL=flipsaura187@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# WhatsApp Integration Configuration
# Provider choices: meta (Official Meta WhatsApp Cloud API), fireclashpro (Gateway), twilio, or mock
WHATSAPP_PROVIDER=fireclashpro
WHATSAPP_ADMIN_PHONE=919876543210

# Option A: Meta WhatsApp Cloud API (WhatsApp Business Platform)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Optional approved Meta templates (if using template-based messaging outside 24h window)
WHATSAPP_TEMPLATE_ADMIN_BOOKING=admin_new_booking
WHATSAPP_TEMPLATE_CUSTOMER_BOOKING=customer_booking_received

# Option B: FireClashPro Gateway (waapi.fireclashpro.com)
WHATSAPP_API_URL=https://waapi.fireclashpro.com/api/v1/messages/send
WHATSAPP_SESSION_ID=your_session_id
WHATSAPP_API_KEY=your_wag_live_api_key

# Option C: Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
